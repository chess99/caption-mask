{
  "name": "Caption Mask",
  "short_name": "Caption Mask",
  "version": "$VERSION",
  "description": "用可拖动、可缩放的遮罩挡住视频字幕，帮助你进行无字幕听力练习。",
  "homepage_url": "https://github.com/chess99/caption-mask",
  "author": "chess99",
  "manifest_version": 3,
  "minimum_chrome_version": "95",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": "icons/icon128.png",
    "default_title": "显示或隐藏字幕遮罩（Alt+M）"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+M"
      }
    }
  }
}
