{
  "name": "caption-mask",
  "version": "1.0.0",
  "description": "A minimal Chrome extension that masks video captions for listening practice.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pack": "node scripts/build.mjs --pack",
    "buildPack": "pnpm build:pack",
    "clean": "node scripts/clean.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build:pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chess99/caption-mask.git"
  },
  "keywords": [
    "Chrome extensions",
    "caption"
  ],
  "author": "chess99",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chess99/caption-mask/issues"
  },
  "homepage": "https://github.com/chess99/caption-mask#readme",
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
